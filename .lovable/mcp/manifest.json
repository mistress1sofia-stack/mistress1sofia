{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lrksvmigpomlntvgjcay.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "mistress-sofia",
      "version": "0.1.0",
      "title": "Mistress Sofia"
    },
    "tools": [
      {
        "name": "list_requests",
        "title": "List requests",
        "description": "List saved applications or booking requests in the owner's private inbox (owner account only).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "applications",
                "booking_requests"
              ],
              "description": "Which inbox to read."
            },
            "status": {
              "default": "new",
              "description": "Only unreviewed requests, or all.",
              "type": "string",
              "enum": [
                "new",
                "all"
              ]
            },
            "limit": {
              "default": 25,
              "description": "Maximum rows to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_request",
        "title": "Get request",
        "description": "Read the full details of one application or booking request by id (owner account only).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "applications",
                "booking_requests"
              ],
              "description": "Which inbox the request is in."
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Request id from list_requests."
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "set_request_reviewed",
        "title": "Mark request reviewed",
        "description": "Mark an application or booking request as reviewed, or back to new (owner account only).",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "applications",
                "booking_requests"
              ],
              "description": "Which inbox the request is in."
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Request id from list_requests."
            },
            "reviewed": {
              "type": "boolean",
              "description": "true = reviewed, false = new."
            }
          },
          "required": [
            "type",
            "id",
            "reviewed"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
